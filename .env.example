# ========================================================
# VibeCheck UI - Environment Variables (Local & Vercel)
# ========================================================

# Google GenAI / Fast Vision API key (Required for hosted vision analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Set to false in production / Vercel so vision models run live
USE_LOCAL_ENGINE=false

# Optional: Custom Open-Weight OpenAI-compatible endpoint (Groq, Together, Ollama, etc.)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_api_key_here
# VLM_MODEL=qwen2.5-vl:7b
# VERIFIER_MODEL=qwen2.5-vl:7b

# Coordinate and upload restrictions
COORD_CONVENTION=normalized
MAX_UPLOAD_MB=5
MAX_IMAGE_PX=1568
