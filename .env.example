# Open-Weight AI Endpoint (Ollama or hosted OpenAI-compatible open model provider)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
VLM_MODEL=qwen2.5-vl:7b
VERIFIER_MODEL=qwen2.5-vl:7b
COORD_CONVENTION=normalized
MAX_UPLOAD_MB=5
MAX_IMAGE_PX=1568

# Set to true to run 100% offline localhost testing engine (no external API calls)
USE_LOCAL_ENGINE=true

# Optional local fallback if hosted endpoint is unreachable
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
